# Build output
_site/
.cache/
.eleventy-cache/

# Dependencies
node_modules/

# Video is never versioned. These are large binaries that bloat the repo and
# every clone permanently, and git stores each re-encode as a whole new blob.
# Video must be served from a CDN instead — see README §9.3, which lists the
# three files still waiting on a base URL. Poster frames are images and stay.
*.mp4
*.webm
*.mov
*.m4v
*.avi
*.ogv

# Import leftovers. NEVER commit these.
#
# The content import (README §4) read a full site export, including a database
# dump holding account emails and password hashes, 3,782 historical form
# submissions with client PII, and API keys. The export is gone; these rules
# stay so that a restored copy can never be committed by accident. This repo
# deploys to Cloudflare Pages through a GitHub integration.
www/
/reconstructed-site

# Secrets — Turnstile's SECRET key, the Sveltia OAuth client secret, and any
# credentials a future Worker needs. These belong in Cloudflare Worker secrets,
# never in the repo.
#
# Two keys that look like secrets and are not, both public by design because
# they ship in the HTML: Turnstile's SITE key (data/global.json) and the
# Web3Forms access_key (site/_includes/contact-form.njk). See README §10.
.env
.env.*
!.env.example
.dev.vars


# Root-owned leftovers from an npm run under sudo. Deleting them needs sudo,
# so they are ignored here rather than removed.
*.root-owned.trash/

# Local editor and tool state
#   .claude/launch.json IS tracked: it is the shared preview-server definition.
#   Only the per-developer permission grants are ignored.
.claude/settings.local.json
.vs

# macOS
.DS_Store
._*

# Scratch
*.log
tmp/
scratch/
