# ---------------------------------------------------------------------------
# The WordPress export — 4.5 GB, deliberately NOT in version control.
#
# It is read-only source material: the SQL dump every content-extraction script
# reads, the active theme used as a design reference, and the original media.
# Nothing in it is ever edited or deployed.
#
# If this folder is missing on your machine, see "Restoring www/" in README.md.
# ---------------------------------------------------------------------------

# Exports
www/
/reconstructed-site

# Visual Studio
.vs

# macOS
.DS_Store
._*

# Python (tools/wpdump.py)
__pycache__/
*.py[cod]

# Node / Eleventy (from phase B onward)
node_modules/
_site/
.cache/
.eleventy-cache/

# Secrets — Turnstile keys, Resend SMTP credentials, OAuth client secrets.
# These belong in Cloudflare Worker secrets, never in the repo.
.env
.env.*
!.env.example
.dev.vars

# Claude Code local state — per-developer permission grants, not shared config.
# .claude/launch.json IS tracked: it's the shared preview-server definition.
.claude/settings.local.json

# Scratch
*.log
tmp/
scratch/

# Root-owned leftovers from an npm run under sudo; removing them needs sudo, so
# they are ignored rather than deleted here.
*.root-owned.trash/

# Derived cache: _wp_attached_file lookups, rebuilt from the SQL dump by
# tools/recover-media.py in about 90 seconds.
/data/attachment-ids.json
