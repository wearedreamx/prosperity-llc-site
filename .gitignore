# Build output
_site/
.cache/
.eleventy-cache/

# Dependencies
node_modules/

# ---------------------------------------------------------------------------
# The WordPress export. NEVER commit this.
#
# It is read-only source material: the phpMyAdmin SQL dump that every
# content-extraction script reads, and the active theme kept as a design
# reference. Nothing in it is edited or deployed. Its media was recovered into
# site/assets/ and committed, so the uploads tree is gone (README §4) — what
# remains is 68 MB.
#
# Keeping it out of git is a security requirement, not a size one. The dump
# holds ynrh_users (account emails and password hashes), ynrh_gf_entry and
# ynrh_wpforms_entries (3,782 historical form submissions — client names,
# emails, phone numbers and message bodies), ynrh_gf_rest_api_keys and
# ynrh_itsec_opaque_tokens. This repo deploys to Cloudflare Pages through a
# GitHub integration; committing the dump would publish all of that.
#
# Missing on your machine? See "Restoring www/" in README.md §1.
# ---------------------------------------------------------------------------
www/
/reconstructed-site

# Secrets — Turnstile keys, Resend SMTP credentials, OAuth client secrets.
# These belong in Cloudflare Worker secrets, never in the repo.
.env
.env.*
!.env.example
.dev.vars

# Derived, rebuildable artifacts
#   attachment-ids.json: _wp_attached_file lookups, rebuilt from the SQL dump
#   by tools/recover-media.py in about 90 seconds.
/data/attachment-ids.json
__pycache__/
*.py[cod]

# Root-owned leftovers from an npm run under sudo. Deleting them needs sudo,
# so they are ignored here rather than removed.
*.root-owned.trash/

# Local editor and tool state
#   .claude/launch.json IS tracked: it is the shared preview-server definition.
#   Only the per-developer permission grants are ignored.
.claude/settings.local.json
.vs

# macOS
.DS_Store
._*

# Scratch
*.log
tmp/
scratch/
