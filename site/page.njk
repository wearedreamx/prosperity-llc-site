---
pagination:
  data: genericPages
  size: 1
  alias: page
permalink: "{{ page.path }}"
eleventyComputed:
  title: "{{ page.title }}"
  description: "{{ page.meta_description }}"
  canonicalUrl: "https://www.prosperityllc.com{{ page.path }}"
layout: base.njk
---
<section class="page-banner">
	<div class="page-banner-content">
		<div class="page-banner-content-container container">
			{% if page.banner_title %}<h1 class="page-banner-title">{{ page.banner_title | safe }}</h1>{% endif %}
			{% if page.banner_description_html %}<div class="content">{{ page.banner_description_html | safe }}</div>{% endif %}
		</div>
	</div>
	{% if page.banner_image %}<figure class="page-banner-figure"><img src="{{ page.banner_image }}" alt="" class="page-banner-image"></figure>{% endif %}
</section>

{% set blocks = page.blocks %}
{% include "content-blocks.njk" %}
