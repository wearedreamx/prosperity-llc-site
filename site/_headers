# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/
# Copied to the deploy root as _headers by eleventy.config.js, the same way
# _redirects is.
#
# The site is static: no cookies, no sessions, no authenticated state. These
# headers exist to constrain what a page is allowed to load and how much
# referrer data leaves the site — cheap here, because the only third-party
# origins are Google Fonts, the Greenhouse job board on /careers/, and
# Cloudflare Turnstile once the form Worker ships (README §9 Phase G).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # script-src needs 'unsafe-inline' for the Greenhouse loader on /careers/,
  # which is an inline <script> in site/pages/page.njk. Tighten it to a hash or
  # nonce if that ever moves into a file. frame-src covers the iframe the
  # Greenhouse loader injects and the Turnstile challenge widget.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://boards.greenhouse.io https://*.greenhouse.io https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://*.greenhouse.io https://challenges.cloudflare.com; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'
