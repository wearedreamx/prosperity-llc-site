---
title: "Search - Prosperity Partners"
description: "Search Prosperity Partners — people, services, offices and news."
canonicalUrl: "https://www.prosperityllc.com/search/"
layout: base.njk
permalink: "/search/"
noIndex: true
---
{#
  Search results. Mirrors the theme's search.php: page-banner titled
  "Search Results for: <query>", then .search-results-container wrapping a
  .posts list of per-hit cards (parts/content-search.php).

  Pagefind is a static index built from _site/ after Eleventy writes it (see
  package.json "build"), queried entirely client-side — the form still submits
  as a GET to /search/?q= so a no-JS request lands on a real page, and
  search.js reads ?q= and renders into the containers below.
#}
<section class="page-banner" data-pagefind-ignore>
	<div class="page-banner-content">
		<div class="page-banner-container container">
			<h1 class="page-banner-title">Search Results for: <span id="search-query"></span></h1>
		</div>
	</div>
</section>
<section class="search-results-container">
	<div class="container">
		<form class="search-page-form" role="search" action="/search/" method="get">
			<label class="visually-hidden" for="search-page-input">Search for</label>
			{#- populated by search.js from ?type= so refining a scoped search
			    (e.g. the team directory's "Search members") stays scoped -#}
			<input type="hidden" name="type" id="search-page-type" value="">
			<input id="search-page-input" class="search-page-input" type="search" name="q" placeholder="Search…" autocomplete="off">
			<button class="search-page-submit" type="submit">Search</button>
		</form>

		{#- aria-live so screen readers hear the count change after an async query -#}
		<p class="search-status" id="search-status" role="status" aria-live="polite"></p>
		<div class="posts" id="search-results"></div>
		<nav class="pagination" id="search-more-container" hidden>
			<button class="search-more" id="search-more" type="button">Load more results</button>
		</nav>

		{#- no-JS and zero-result fallback, matching parts/content-none.php's copy -#}
		<noscript>
			<div class="content"><p>Search requires JavaScript. Please <a href="/contact-us/">contact us</a> if you need help finding something.</p></div>
		</noscript>
	</div>
</section>
<script src="/assets/js/search.js" type="module"></script>
