---
title: "Meet the Team - Prosperity Partners"
canonicalUrl: "https://www.prosperityllc.com/meet-the-team/"
layout: base.njk
permalink: "/meet-the-team/"
---
<section class="page-banner">
	<div class="page-banner-content">
		<div class="page-banner-container container">
			<h2 class="page-banner-title">Meet the Team</h2>
		</div>
	</div>
	<figure class="page-banner-figure"><img src="/assets/img/uploads/pages/meet-the-team.jpg" alt="" class="page-banner-image"></figure>
</section>
<section class="single-post-container">
	<div class="container">
		{% include "team-filters.njk" %}
		<p class="team-empty" data-team-empty role="status" aria-live="polite" hidden></p>
		{#- each person is indexed from their own /personnel/<slug>/ page; indexing
		    the 198 cards here too would match every name query twice and rank a
		    directory listing alongside the actual bio -#}
		<div class="team-container" data-pagefind-ignore>
			{% for person in collections.teamOrder %}
			{#- term classes the filter matches on: title facet, location slug, service lines -#}
			{%- set locSlug = person.data.location_url | replace("/location/", "") | replace("/", "") -%}
			<article class="team-member active{% if person.data.facet_title %} {{ person.data.facet_title }}{% endif %}{% if locSlug %} {{ locSlug }}{% endif %}{% for s in person.data.facet_specializations %} {{ s }}{% endfor %}" data-name="{{ person.data.name }}">
				<a href="/personnel/{{ person.data.slug }}/" class="team-member-link">
					<figure class="team-member-figure">
						{% if person.data.photo %}<img width="550" height="500" src="{{ person.data.photo }}" alt="" class="team-member-img">{% endif %}
					</figure>
					<div class="team-member-content">
						<h3 class="team-member-name">{{ person.data.name }}{% if person.data.certifications %}<span class="team-member-certs">{{ person.data.certifications }}</span>{% endif %}</h3>
						<h5 class="team-member-title">{{ person.data.job_title }}</h5>
						<p class="team-member-location">{{ person.data.location_name }}</p>
					</div>
				</a>
			</article>
			{% endfor %}
		</div>
	</div>
</section>
