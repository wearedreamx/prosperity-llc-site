---
title: "Meet the Team"
permalink: "/meet-the-team/"
eleventyComputed:
  description: "{{ collections.pagesBySlug['meet-the-team'].data.meta_description | safe }}"
layout: base.njk
---
{% from "page-banner.njk" import pageBanner %}
{#- Banner copy, image and description come from the page's own record rather
    than being restated here. This template exists because the roster grid and
    its filter are not expressible as content blocks — not because the banner is
    different, and the two drifting apart was a standing hazard. -#}
{% set record = collections.pagesBySlug["meet-the-team"] %}
{% from "team-card.njk" import teamCard with context %}
{{ pageBanner({ title: record.data.banner_title, descriptionHtml: record.data.banner_description_html, image: record.data.banner_image, thumb: true }) }}
{#- `.team` is what carries the 4em of space under the banner; naming this
    wrapper anything else leaves the filter bar flush against it. -#}
<section class="team">
	<div class="container">
		{% set hideSearchButton = true %}{% include "team-filters.njk" %}
		<p class="team-empty" data-team-empty role="status" aria-live="polite" hidden></p>
		{#- each person is indexed from their own /personnel/<slug>/ page; indexing
		    the 200 cards here too would match every name query twice and rank a
		    directory listing alongside the actual bio -#}
		<div class="team-container" data-pagefind-ignore>
			{#- level 2: this page is the directory, so the cards are its content
			    and sit directly under the <h1>. -#}
			{%- for person in collections.teamOrder %}{{ teamCard(person, true, true, 2) }}{% endfor %}
		</div>
	</div>
</section>
