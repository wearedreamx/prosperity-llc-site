---
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "{{ post.data.category | categoryPath }}{{ post.data.slug }}/"
eleventyComputed:
  title: "{{ post.data.title | safe }}"
  description: "{{ ((post.rawInput | mdText | plainText) or (post.data.title + ' — ' + (post.data.category | categoryName) + ' at Prosperity Partners')) | truncate(160) | safe }}"
  ogImage: "{% if post.data.images.length %}{{ global.site_url }}{{ post.data.images[0] }}{% endif %}"
  ogPublished: "{{ post.data.published }}"
ogType: article
searchType: post
layout: base.njk
---
{% from "page-banner.njk" import pageBanner %}
{{ pageBanner({ parentHref: post.data.category | categoryPath, parentLabel: post.data.category | categoryName, pagefindIgnore: true }) }}
<section class="single-post-container">
	<div class="single-post-content-container container">
		{#- Live runs the post's images as a Slick slideshow in this column. The
		    rebuild has no carousel library by design, and rendering only
		    images[0] hid 384 of the 488 images the import committed — 50 of the
		    104 posts carry more than one. They stack instead, which shows all of
		    them and needs no client runtime. Only the first carries the Pagefind
		    thumbnail meta. -#}
		{%- if post.data.images.length %}
		<div class="single-post-figures">
			{%- for image in post.data.images %}
			{#- alt is empty on purpose, and it is the least-wrong option rather
			    than a good one. It used to read "Prosperity Partners team members
			    at {title}", generated for all 488 images — which is false on every
			    award, podcast and press-release post, and unverifiable on the
			    rest: nothing in the record says what any photo shows. WCAG treats
			    invented filler as worse than nothing, so these are marked
			    decorative until an editor can describe them. The real fix is an
			    alt field beside each entry in `images` when pages/ gets its CMS
			    collection (README §6b) — tracked in the review report. -#}
			<figure class="single-post-figure"><img src="{{ image }}" alt="" class="single-post-image" loading="{{ 'eager' if loop.first else 'lazy' }}"{% if loop.first %} data-pagefind-meta="image[src]"{% endif %}></figure>
			{%- endfor %}
		</div>
		{%- endif %}
		<div class="single-post-content">
			{#- The date precedes the title visually, but as a heading it made every
			    post page open at h5 and then jump up to h1. It is a <time>. -#}
			{% if post.data.published %}<p class="single-post-meta"><time datetime="{{ post.data.published | isoDate }}">{{ post.data.published | longDate }}</time></p>{% endif %}
			<h1 class="single-post-title">{{ post.data.title }}</h1>
			<div class="content">
				{{ post.content | safe }}
			</div>
		</div>
	</div>
</section>
