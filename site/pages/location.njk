---
pagination:
  data: collections.locations
  size: 1
  alias: location
permalink: "/location/{{ location.data.slug }}/"
eleventyComputed:
  title: "{{ location.data.name | safe }}"
  description: "{{ ('Prosperity Partners in ' + location.data.name + '. ' + (location.rawInput | mdText | plainText)) | truncate(160) | safe }}"
  ogImage: "{% if location.data.banner_image %}{{ global.site_url }}{{ location.data.banner_image }}{% endif %}"
searchType: location
layout: base.njk
---
{% from "page-banner.njk" import pageBanner %}
{% from "team-card.njk" import teamCard with context %}
{% from "office-address.njk" import officeAddress %}
{{ pageBanner({ image: location.data.banner_image, thumb: true }) }}
<section class="single-location-container">
	<div class="container">
		<div class="single-location-top">
			<div class="single-location-address">
				<h1 class="single-location-title">{{ location.data.name }}</h1>
				{{ officeAddress(location.data) }}
			</div>
			<div class="single-location-content content">
				{{ location.content | safe }}
			</div>
		</div>
		{%- set team = collections.personnelByLocation[location.data.slug] %}
		{%- if team %}
		{#- The roster is a section of the location page, not the page itself
		    (unlike /meet-the-team/), so it gets its own heading and the cards stay
		    h3 beneath it. Without this the page ran h1 → h3 on all 11 offices.
		    Visually hidden because the grid reads as a roster on sight and the
		    live layout has no heading here — see README §9.2. -#}
		<h2 class="visually-hidden">{{ location.data.name }} team</h2>
		{#- The Location facet is hidden here: every card in this grid is at this
		    office already, so filtering by location would only ever empty it. -#}
		{% set hideFacet = "Location" %}{% include "team-filters.njk" %}
		<p class="team-empty" data-team-empty role="status" aria-live="polite" hidden></p>
		{#- roster cards are indexed from each person's own /personnel/<slug>/ page -#}
		<div class="team-container" data-pagefind-ignore>
			{%- for person in team %}{{ teamCard(person) }}{% endfor %}
		</div>
		{%- endif %}
	</div>
</section>
