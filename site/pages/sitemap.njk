---
permalink: "/sitemap/"
layout: base.njk
# Kept out of the Pagefind index for the same reason culture.njk and
# whats-new.njk are (base.njk explains the mechanism): this page holds the title
# of every page, post and location on the site, so it matched almost any query
# and outranked the record the searcher actually wanted.
noIndex: true
eleventyComputed:
  title: "{{ collections.pagesBySlug['sitemap'].data.title | safe }}"
  description: "Every page, post and office on the Prosperity Partners site."
---
{% from "page-banner.njk" import pageBanner %}
{#- The old site built this list with a CMS plugin, so the import captured no
    content for the record — the page rendered as a banner with no links, while
    being linked from the footer of all 373 pages. It is derived from the
    collections now, mirroring the live page's three sections. -#}
{% set record = collections.pagesBySlug["sitemap"] %}
{{ pageBanner({ title: record.data.banner_title, image: record.data.banner_image }) }}
<section class="content-block">
	<div class="content-block-container container content-block-container-one">
		<div class="content-block-content content">
			<h2>Pages</h2>
			<ul class="sitemap-list">
				<li><a href="/">Home</a></li>
				{%- for page in collections.sitemapPages %}
				<li><a href="{{ page.url }}">{{ page.title }}</a>
					{%- if page.children.length %}
					<ul>
						{%- for child in page.children %}
						<li><a href="{{ child.url }}">{{ child.title }}</a></li>
						{%- endfor %}
					</ul>
					{%- endif %}
				</li>
				{%- endfor %}
			</ul>

			<h2>Posts by category</h2>
			{#- Path and label come from data/post-categories.json via the filters,
			    not written out here — that file exists so the archive path and the
			    display name cannot drift from what the post links use. -#}
			<h3><a href="{{ 'culture' | categoryPath }}">{{ 'culture' | categoryName }}</a></h3>
			<ul class="sitemap-list">
				{%- for post in collections.culturePosts %}
				<li><a href="{{ post.data.category | categoryPath }}{{ post.data.slug }}/">{{ post.data.title }}</a></li>
				{%- endfor %}
			</ul>
			<h3><a href="{{ 'whats-new' | categoryPath }}">{{ 'whats-new' | categoryName }}</a></h3>
			<ul class="sitemap-list">
				{%- for post in collections.whatsNewPosts %}
				<li><a href="{{ post.data.category | categoryPath }}{{ post.data.slug }}/">{{ post.data.title }}</a></li>
				{%- endfor %}
			</ul>

			<h2>Locations</h2>
			<ul class="sitemap-list">
				{%- for location in collections.locations %}
				<li><a href="/location/{{ location.data.slug }}/">{{ location.data.name }}</a></li>
				{%- endfor %}
			</ul>
		</div>
	</div>
</section>
