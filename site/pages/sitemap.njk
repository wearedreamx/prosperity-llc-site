---
permalink: "/sitemap/"
layout: base.njk
eleventyComputed:
  title: "{{ collections.pagesBySlug['sitemap'].data.title | safe }}"
  description: "Every page, post and office on the Prosperity Partners site."
---
{#- The old site built this list with a CMS plugin, so the import captured no
    content for the record — the page rendered as a banner with no links, while
    being linked from the footer of all 373 pages. It is derived from the
    collections now, mirroring the live page's three sections. -#}
{% set record = collections.pagesBySlug["sitemap"] %}
<section class="page-banner">
	<div class="page-banner-content">
		<div class="page-banner-content-container container">
			<h1 class="page-banner-title">{{ record.data.banner_title }}</h1>
		</div>
	</div>
	{%- if record.data.banner_image %}<figure class="page-banner-figure"><img src="{{ record.data.banner_image }}" alt="" class="page-banner-image"></figure>{% endif %}
</section>
<section class="content-block">
	<div class="content-block-container container content-block-container-one">
		<div class="content-block-content content">
			<h2>Pages</h2>
			<ul class="sitemap-list">
				<li><a href="/">Home</a></li>
				{%- for page in collections.sitemapPages %}
				<li><a href="{{ page.url }}">{{ page.title }}</a>
					{%- if page.children.length %}
					<ul>
						{%- for child in page.children %}
						<li><a href="{{ child.url }}">{{ child.title }}</a></li>
						{%- endfor %}
					</ul>
					{%- endif %}
				</li>
				{%- endfor %}
			</ul>

			<h2>Posts by category</h2>
			<h3><a href="/culture/">Culture</a></h3>
			<ul class="sitemap-list">
				{%- for post in collections.culturePosts %}
				<li><a href="{{ post.data.category_url }}{{ post.data.slug }}/">{{ post.data.title | safe }}</a></li>
				{%- endfor %}
			</ul>
			<h3><a href="/whats-new/">What's New</a></h3>
			<ul class="sitemap-list">
				{%- for post in collections.whatsNewPosts %}
				<li><a href="{{ post.data.category_url }}{{ post.data.slug }}/">{{ post.data.title | safe }}</a></li>
				{%- endfor %}
			</ul>

			<h2>Locations</h2>
			<ul class="sitemap-list">
				{%- for location in collections.locations %}
				<li><a href="/location/{{ location.data.slug }}/">{{ location.data.name }}</a></li>
				{%- endfor %}
			</ul>
		</div>
	</div>
</section>
