{#
  The one personnel card, shared by /meet-the-team/ and every location page.
  The two copies differed only in whether the location line shows and whether
  the location-slug filter term is emitted, so both are parameters now.

  The term classes are what the filter in main.js matches on: a card stays
  visible only while its class list contains every selected term. `active` is
  what makes it visible at all — .team-member is opacity:0 by default — so it is
  rendered on, and JS only ever takes it away.

  7 of the 200 records have no headshot. The live site falls back to a house
  graphic at the same 550x500 as a real photo, so the card keeps its shape
  instead of collapsing to an empty figure; dropping a real photo into the
  record's `photo` field replaces it with no other change.
#}
{% macro teamCard(person, withLocation = false, withLocationTerm = false) %}
{%- set locSlug = person.data.location_url | replace("/location/", "") | replace("/", "") -%}
<article class="team-member active{% if person.data.facet_title %} {{ person.data.facet_title }}{% endif %}{% if withLocationTerm and locSlug %} {{ locSlug }}{% endif %}{% for s in person.data.facet_specializations %} {{ s }}{% endfor %}" data-name="{{ person.data.name }}">
	<a href="/personnel/{{ person.data.slug }}/" class="team-member-link">
		<figure class="team-member-figure">
			<img width="550" height="500" src="{{ person.data.photo or '/assets/img/ui/team-placeholder.svg' }}" alt="" class="team-member-img">
		</figure>
		<div class="team-member-content">
			{#- The certs sit in their own element, separated visually by a margin
			    exactly as the live site does it. That runs them into the name in
			    the accessible name ("Jeremy Dubowcpa, mst"), so the comma goes in
			    a visually-hidden span rather than in the visible text. -#}
			<h3 class="team-member-name">{{ person.data.name }}{% if person.data.certifications %}<span class="visually-hidden">, </span><span class="team-member-certs">{{ person.data.certifications }}</span>{% endif %}</h3>
			<p class="team-member-title">{{ person.data.job_title }}</p>
			{%- if withLocation %}
			<p class="team-member-location">{{ person.data.location_name }}</p>
			{%- endif %}
		</div>
	</a>
</article>
{% endmacro %}
