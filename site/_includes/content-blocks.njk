{#
  Generic block renderer: walks a page's blocks[] and renders each by its
  `layout` discriminator (README §6).

  Every column layout resolves to the same container with a layout-suffixed
  class, and site/assets/css/style.css sizes the grid — so there is one rule
  here, not one branch per layout. This used to be a nine-arm if/elif chain in
  which eight arms emitted exactly what the fallback emits.

  Two layouts are not plain containers:
    raw:*          emitted verbatim, no container. Used by the hand-built
                   homepage and team sections, and by raw:cta, which renders
                   the shared CTA component instead of the block's own HTML.
    twoimage-20    needs an outer wrapper the others do not.
#}
{% macro block(b) %}
{%- if b.layout.startsWith("raw:") -%}
{{ b.html | injectContactForm | safe }}
{%- elif b.layout == "twoimage-20" -%}
<div class="content-block-container-twoimage-top content-block-container-twoimage-20"><div class="content-block-container container content-block-container-twoimage content-block-container-with-image-left">{{ b.html | injectContactForm | safe }}</div></div>
{%- else -%}
<div class="content-block-container container content-block-container-{{ b.layout }}">{{ b.html | injectContactForm | safe }}</div>
{%- endif -%}
{% endmacro %}

{% for b in blocks %}
{%- if b.layout == "raw:cta" -%}
{% include "cta.njk" %}
{%- elif b.layout.startsWith("raw:") -%}
{{ block(b) }}
{%- else -%}
<section class="content-block">{{ block(b) }}</section>
{%- endif -%}
{% endfor %}
