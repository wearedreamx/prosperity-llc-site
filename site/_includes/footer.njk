{% from "office-address.njk" import officeAddress %}
	<footer class="site-footer">
		<div class="container">
			<div class="site-footer__columns">
				<div class="site-footer__column">
					<address class="contact-details">
						Phone : <a href="tel:{{ global.phone_tel }}">{{ global.phone }}</a><br>
						Fax : {{ global.fax }}<br>
						Email: <a href="mailto:{{ global.email }}">{{ global.email }}</a>
					</address>
				</div>
				<nav class="site-footer__column" aria-labelledby="footer-site-menu">
					<h2 class="site-footer__heading" id="footer-site-menu">Site Menu</h2>
					<ul class="footer-menu">
						<li><a href="/">Home</a></li>
						<li><a href="/services/">Services</a></li>
						<li><a href="/company/">Company</a></li>
						<li><a href="/partnerships/">Partnerships</a></li>
						<li><a href="/contact-us/">Contact</a></li>
						<li><a href="/careers/">Careers</a></li>
						<li><a href="/payment/">Payment</a></li>
						<li><a href="/client-portal/">Client Portal</a></li>
					</ul>
				</nav>
				<nav class="site-footer__column" aria-labelledby="footer-recent-posts">
					<h2 class="site-footer__heading" id="footer-recent-posts">Recent Posts</h2>
					<ul class="footer-menu">
						{% for post in collections.recentPosts %}
						<li><a href="{{ post.data.category | categoryPath }}{{ post.data.slug }}/">{{ post.data.title }}</a></li>
						{% endfor %}
					</ul>
				</nav>
				<div class="site-footer__column">
					<h2 class="site-footer__heading">Follow Us</h2>
					<ul class="social">
						<li><a class="social__link social__link--linkedin" href="{{ global.linkedin_url }}" rel="noopener" target="_blank">LinkedIn</a></li>
					</ul>
				</div>
			</div>
		</div>

		{#- The office list is the footer's fourth section, so its per-office <h3>s
		    need an <h2> above them the way the three columns above have one —
		    without it every page's outline ran h1 → h3. The heading is
		    visually-hidden because the grid is self-evident on screen; it exists
		    for the outline and for the aria-labelledby below. -#}
		<section class="locations" aria-labelledby="footer-offices">
			<div class="container">
				<h2 class="visually-hidden" id="footer-offices">Our offices</h2>
				<ul class="locations__grid">
					{% for location in collections.footerLocations %}
					<li class="location">
						<h3 class="location__title"><a href="/location/{{ location.data.slug }}/">{{ location.data.name }}</a>{% if location.data.non_attest %}*{% endif %}</h3>
						{{ officeAddress(location.data) }}
					</li>
					{% endfor %}
				</ul>
			</div>
		</section>

		<div class="container disclaimer">
			{{ global.footer_disclaimer_html | safe }}
			{#- Read from global rather than written out here: data/global.json has
			    carried this exact sentence as non_attest_note since the import, and
			    the hardcoded copy meant the asterisk's explanation and the asterisk
			    itself (the non_attest flag on each location) could drift apart. -#}
			<p>{{ global.non_attest_note }}</p>
		</div>

		<div class="copyright">
			{{ global.footer_copyright_html | replace("©", "© " + currentYear) | safe }}
		</div>
	</footer>
