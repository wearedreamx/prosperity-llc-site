{#
  3-facet filter for the team directory. Mirrors the theme's
  pages/team/filters.php: each option carries a data-term, and a card is shown
  when its class list contains every selected term. Terms come from
  data/team-filters.json; the matching classes are emitted on each card by
  team-card.njk.

  The trigger, the options and Reset are real <button>s. They used to be a
  div[role=button], 26 plain <li>s and a span[role=button] — so all 26 options
  had no tabindex and nothing focusable in them. A keyboard user could open a
  dropdown and then could not select anything inside it. Buttons are focusable,
  activate on Enter and Space, and are announced as buttons, which removes the
  role/tabindex scaffolding and the keydown handlers that went with it.
#}
<div class="team-filters-container" data-pagefind-ignore>
	<ul class="team-filters">
		{% for facet in teamFilters %}{% if facet.label != hideFacet %}
		<li class="team-filter" data-label="{{ facet.label }}">
			<button class="team-filter-header" type="button" aria-expanded="false">{{ facet.label }}</button>
			<ul class="team-filter-dropdown">
				<li><button class="team-filter-link active" type="button" data-term="all">All</button></li>
				{% for t in facet.terms %}<li><button class="team-filter-link" type="button" data-term="{{ t.term }}">{{ t.label }}</button></li>{% endfor %}
			</ul>
		</li>
		{% endif %}{% endfor %}
		<li class="team-filter"><button class="team-filter-reset" type="button">Reset</button></li>
	</ul>
	<div class="team-search">
		{#- Filters the cards on this page by name rather than submitting to
		    /search/: the theme scoped this box to personnel with a hidden
		    post_type input, but a full-text personnel search matches bio prose
		    too, so "tax" returned 140 of 200 members. Name-matching in place is
		    what "Search members" means next to the facet dropdowns, and it keeps
		    the result in the directory. Still a real <form> with a GET action so
		    a no-JS submit degrades to the site search instead of doing nothing. -#}
		<form role="search" method="get" class="searchform" action="/search/" data-team-search>
			<label class="team-search-label" for="team-s">Search for:</label>
			<input type="hidden" name="type" value="personnel">
			<input class="team-search-input" placeholder="Search members" type="text" name="q" id="team-s" autocomplete="off">
			<input class="team-search-button" type="submit" value="Search">
		</form>
	</div>
</div>
