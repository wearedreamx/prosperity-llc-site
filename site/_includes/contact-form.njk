{#
  The shared contact form. README §10: nine forms on the old site collapse to one
  component — seven are the identical 5-field shape, and the site-wide Contact
  Form adds a referral-source radio plus its conditional text field, which is
  what `formVariant: "contact"` selects.

  `idPrefix` exists because a page can carry two of these: the site-wide CTA
  block plus a form embedded mid-content by the old editor. When both rendered
  with fixed ids, `/client-accounting-services/back-office-accounting/` shipped
  cf-first, cf-last, cf-email, cf-phone and cf-message twice, and every
  <label for> in the second form resolved to the first form's field.
  eleventy.config.js's injectContactForm passes a distinct prefix per marker.
#}
{% set p = idPrefix or "cf" %}
<form class="contact-form" action="https://api.web3forms.com/submit" method="post">
	<input type="hidden" name="access_key" value="091427a2-a2e1-46a0-96f4-732d1f62a9df"
	<h3 class="visually-hidden">Contact us</h3>
	<div class="contact-form__row">
		<div class="field">
			<label class="visually-hidden" for="{{ p }}-first">First name</label>
			<input id="{{ p }}-first" name="first_name" type="text" autocomplete="given-name" placeholder="First name*" required>
		</div>
		<div class="field">
			<label class="visually-hidden" for="{{ p }}-last">Last name</label>
			<input id="{{ p }}-last" name="last_name" type="text" autocomplete="family-name" placeholder="Last name*" required>
		</div>
	</div>
	<div class="field">
		<label class="visually-hidden" for="{{ p }}-email">Email address</label>
		<input id="{{ p }}-email" name="email" type="email" autocomplete="email" placeholder="Email address*" required>
	</div>
	<div class="field">
		<label class="visually-hidden" for="{{ p }}-phone">Phone number</label>
		<input id="{{ p }}-phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone number">
	</div>
	<div class="field">
		<label class="visually-hidden" for="{{ p }}-message">Message</label>
		<textarea id="{{ p }}-message" name="message" rows="4" placeholder="Message*" required></textarea>
	</div>
	{% if formVariant == "contact" %}
	<fieldset class="field field--radio-group">
		<legend>How did you hear about us?<span class="field__required">*</span></legend>
		<div class="field__radio-row">
			<label><input type="radio" name="referral_source" value="Social Media" required> Social Media</label>
			<label><input type="radio" name="referral_source" value="Peer Referral" required> Peer Referral</label>
			<label><input type="radio" name="referral_source" value="Google/ Search Engine" required> Google/ Search Engine</label>
			<label><input type="radio" name="referral_source" value="Other" required data-toggle-other> Other</label>
		</div>
		<div class="field field--other" hidden data-other-field>
			<label class="visually-hidden" for="{{ p }}-referral-other">Other</label>
			<input id="{{ p }}-referral-other" name="referral_source_other" type="text" placeholder="Please specify*">
		</div>
	</fieldset>
	{% endif %}
	{#- Turnstile renders into this div, but only once the widget script is on the
	    page — see base.njk. Both the script and a real site key are required
	    before the form Worker ships (README §9 Phase G); with a placeholder key
	    the widget renders an error rather than a challenge. -#}
	<div class="cf-turnstile" data-sitekey="{{ global.turnstile_site_key }}" data-theme="light"></div>
	<p class="contact-form__footer">
		<button class="button button--ghost" type="submit">Send Message</button>
	</p>
</form>
