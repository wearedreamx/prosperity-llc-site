{% from "page-banner.njk" import pageBanner %}
{#
  Body shared by /culture/ and /whats-new/, which were byte-identical templates
  apart from six values. Each archive is still its own template file because
  Eleventy paginates one collection per file, but they now differ only in
  frontmatter: `archiveTitle`, `archiveImage` and the paginated collection.
#}
{% from "post-card.njk" import postCard %}
{#- archiveDescription is the category blurb; it lived on the CMS category
    term rather than on a page, so the import never captured it and both
    archives shipped a bare title. Recovered from the live pages and kept in
    each archive's frontmatter, since neither has a page record. -#}
{{ pageBanner({ title: archiveTitle, description: archiveDescription, image: archiveImage }) }}
<section class="posts">
	<div class="container">
		<div class="posts__grid">
			{#- level 2: on an archive the cards are the page's own content, sitting
			    directly under the <h1> with no section heading between. -#}
			{%- for post in pagePosts %}{{ postCard(post, true, 2) }}{% endfor %}
		</div>
		{%- if pagination.href.previous or pagination.href.next %}
		<nav class="pagination" aria-label="{{ archiveTitle }} pagination">
			{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">&larr; Newer</a>{% endif %}
			{% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older &rarr;</a>{% endif %}
		</nav>
		{%- endif %}
	</div>
</section>
